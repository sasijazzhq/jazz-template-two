# Rusi AI runs fully without any of these (Demo Mode + manual entry).
# All keys are server-side only. Never prefix them with NEXT_PUBLIC_.

# Screenshot reading (Phase B). When set, Swiggy/Zomato checkout screenshots
# are sent to Google Gemini to read the amounts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Automated restaurant calls (Phase D) — NOT IMPLEMENTED YET. These are read,
# but no ElevenLabs adapter exists, so calling always reports unavailable.
ENABLE_VOICE_CALLS=false
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=

# Persistence (optional, planned) — NOT WIRED UP YET. Data is stored in the
# browser's localStorage. Schema: docs/DATA_MODEL.md
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
